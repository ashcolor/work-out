{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend dev server",
      "type": "shell",
      "command": "pnpm run dev -- --host 0.0.0.0 --port 3008",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      }
    }
  ]
}
